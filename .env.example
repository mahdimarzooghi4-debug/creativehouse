# Local development. In production use: file:/data/creativehouse.db
DATABASE_URL="file:./prisma/dev.db"

# Generate a long random value (at least 32 characters) for production.
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# Used only when the database has no admin user yet.
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password-min-12-chars"
ADMIN_INITIAL_NAME="مدیر سایت"
