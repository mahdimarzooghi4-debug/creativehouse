# Production database lives on the persistent Docker volume mounted at /data.
DATABASE_URL="file:/data/creativehouse.db"

# Generate with: openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-production-secret"

# Used only when the database has no admin user yet.
ADMIN_INITIAL_USERNAME="admin"
ADMIN_INITIAL_PASSWORD="replace-with-a-strong-password-min-12-chars"
ADMIN_INITIAL_NAME="مدیر سایت"
